# Copiar a .env (que NO se sube a git) y ajustar.
# El .env es lo unico que puede cambiar de una maquina a otra.

# --- Modelo del agente -------------------------------------------------------
# Acuerdo del equipo: el razonamiento corre sobre API.
#   claude   -> API de Anthropic   (requiere ANTHROPIC_API_KEY)
#   openai   -> API de OpenAI      (requiere OPENAI_API_KEY)
# Respaldo local, sin costo y sin conexion (calidad menor, ver README seccion 6):
#   llama3.2 | llama3.2:1b | phi4-mini | qwen3 | gemma-lmstudio
AGENT_MODEL=claude

# --- Anthropic ---------------------------------------------------------------
# IDs validos (sin sufijo de fecha) y precio por millon de tokens entrada/salida:
#   claude-opus-5     1M de contexto   $5  / $25   <- el mas capaz
#   claude-sonnet-5   1M de contexto   $2  / $10   <- equilibrio recomendado para desarrollar
#   claude-haiku-4-5  200K de contexto $1  / $5    <- el mas barato, para correr evaluaciones masivas
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI ------------------------------------------------------------------
# Confirmar el ID vigente en https://platform.openai.com/docs/models
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings del RAG ------------------------------------------------------
# ollama = local y gratis (nomic-embed-text) | openai = text-embedding-3-small
# Al cambiar de backend hay que reconstruir el indice:
#   python -m app.agentes.rag.indice --reindexar
EMBEDDINGS_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# --- Flask -------------------------------------------------------------------
FLASK_APP=run.py
FLASK_DEBUG=1
CLEMENTE_PORT=5000

# --- Observabilidad (Adrian) -------------------------------------------------
# Acuerdo del equipo: monitoreamos con LangSmith, asi que va activo.
# El proyecto es COMPARTIDO. Ojo: si cada uno usa SU clave, las trazas quedan en
# la cuenta de cada uno y no se ven juntas aunque el proyecto se llame igual.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=clemente-grupo02
LANGSMITH_API_KEY=

# --- Backends de datos -------------------------------------------------------
CLEMENTE_BACKEND_RESERVAS=json
