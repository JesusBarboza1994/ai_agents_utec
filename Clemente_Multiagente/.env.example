# Copiar a .env (que NO se sube a git) y ajustar.
# El .env es lo unico que puede cambiar de una maquina a otra.

# --- Modelo del agente -------------------------------------------------------
# Acuerdo del equipo: el razonamiento corre sobre API.
#   claude   -> API de Anthropic       (requiere ANTHROPIC_API_KEY)
#   openai   -> API publica de OpenAI  (requiere OPENAI_API_KEY)
#   azure    -> Azure OpenAI Service   (requiere AZURE_OPENAI_API_KEY y AZURE_OPENAI_ENDPOINT)
# Respaldo local, sin costo y sin conexion (calidad menor, ver README seccion 6):
#   llama3.2 | llama3.2:1b | phi4-mini | qwen3 | gemma-lmstudio
AGENT_MODEL=openai

# --- Anthropic ---------------------------------------------------------------
# IDs validos (sin sufijo de fecha) y precio por millon de tokens entrada/salida:
#   claude-opus-5     1M de contexto   $5  / $25   <- el mas capaz, para la corrida final
#   claude-sonnet-5   1M de contexto   $2  / $10   <- el que usamos: ver README seccion 3.1
#   claude-haiku-4-5  200K de contexto $1  / $5    <- el mas barato, para evaluaciones masivas
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Modelo que CALIFICA en las evaluaciones (tests/eval/). Se usa Claude Sonnet 5,
# que a proposito NO es el modelo que responde: un modelo tiende a premiar sus
# propias respuestas, asi que juzgarse a si mismo infla el resultado.
# Acepta modelos de CUALQUIERA de los dos proveedores. Poner uno de OpenAI
# mientras los agentes corren sobre Anthropic es la unica forma de sacarse de
# encima el sesgo de familia (README seccion 10.3).
JUEZ_MODEL=claude-sonnet-5

# Modelo SOLO del enrutador. Vacio = el mismo de arriba. El enrutador clasifica
# en tres rutas con salida estructurada y corre en cada turno, asi que es el
# candidato natural a un modelo mas barato -- pero medir antes con
# `tests/eval/evaluar.py`: si baja la precision de ruteo, no compensa.
ANTHROPIC_MODEL_ENRUTADOR=

# --- OpenAI ------------------------------------------------------------------
# IDs validos y precio por millon de tokens entrada/salida (verificado 2026-09-08):
#   gpt-6-astra     $10 / $50   <- el mas capaz del mercado, y el mas caro
#   gpt-5.6-sol     $4  / $20
#   gpt-5.6-terra   $2  / $12   <- equivalente en precio a claude-sonnet-5
#   gpt-5.6-luna    $0.20/$1.20 <- el mas barato: candidato para el planificador
# Ojo: los modelos de razonamiento (gpt-5 en adelante, gpt-6, serie o) RECHAZAN
# el parametro temperature. `app/llm.py` ya lo omite para esos IDs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# --- Azure OpenAI --------------------------------------------------------------
# Recurso de Azure OpenAI Service (distinto de la API publica de OpenAI: usa
# endpoint propio + "deployment" en vez de un ID de modelo directo).
# El deployment se crea con:
#   az cognitiveservices account deployment create -g <rg> -n <recurso> \
#     --deployment-name <nombre> --model-format OpenAI \
#     --model-name <modelo> --model-version <version> \
#     --sku-name GlobalStandard --sku-capacity 1
# AZURE_OPENAI_DEPLOYMENT debe ser el --deployment-name usado ahi (por
# convencion de este proyecto, igual al --model-name).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Embeddings del RAG ------------------------------------------------------
# ollama = local y gratis | openai = text-embedding-3-small
# El modelo DEBE ser multilingue: el catalogo esta en espanol. Se usa bge-m3
# (`ollama pull bge-m3`, ~1.2 GB). NO usar nomic-embed-text: se midio que no
# discrimina en espanol (README seccion 10).
# Al cambiar de modelo o de backend hay que reconstruir el indice:
#   python -m app.agentes.rag.indice --reindexar
EMBEDDINGS_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDINGS_MODEL=bge-m3
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# --- RAG_BACKEND: donde vive el indice del catalogo --------------------------
#   chroma        (default) -- coleccion local, sin credenciales.
#   azure_search  -- push directo al indice de Azure AI Search via SDK (sin
#                    Blob Storage ni indexer/skillset): este mismo proceso
#                    arma los chunks (igual que con Chroma) y los empuja.
# El indice de Azure Search tiene la dimension del vector fija (1536, para
# text-embedding-3-small) -- si cambian EMBEDDINGS_BACKEND/modelo, hay que
# recrear el indice a mano con esa nueva dimension.
RAG_BACKEND=chroma
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=catalogo-clemente

# --- Flask -------------------------------------------------------------------
FLASK_APP=run.py
FLASK_DEBUG=1
CLEMENTE_PORT=5000

# --- Observabilidad (Adrian) -------------------------------------------------
# Acuerdo del equipo: monitoreamos con LangSmith, asi que va activo.
# El proyecto es COMPARTIDO. Ojo: si cada uno usa SU clave, las trazas quedan en
# la cuenta de cada uno y no se ven juntas aunque el proyecto se llame igual.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=clemente-grupo02
LANGSMITH_API_KEY=

# --- Backends de datos -------------------------------------------------------
# Reservas: "json" (por defecto, referencia) o "postgres" (transacciones,
# recomendado para la demo -- usa CLEMENTE_DATABASE_URL, mas abajo). Con
# "postgres" hay que subir el catalogo de mesas primero:
#   python -m app.reservas.seed
CLEMENTE_BACKEND_RESERVAS=json

# Incidencias: "auto" usa Trello si hay credenciales, y el JSON local si no.
# Fuerza uno u otro con "trello" o "json".
CLEMENTE_BACKEND_INCIDENCIAS=auto

# Estado de los agentes (permisos de reservas, propuestas CONFIRMO, perfil del
# cliente, cola HITL, continuidad, rechazos): "auto" sigue a
# CLEMENTE_BACKEND_RESERVAS (postgres -> tablas agentes_* del mismo Postgres;
# json -> SQLite/JSON locales). Forzar con "postgres" o "local".
CLEMENTE_BACKEND_AGENTES=auto
# Carpeta de los archivos locales (SQLite, JSON, checkpoint HITL). Vacio =
# app/agentes/datos/. En Azure apuntar a un volumen persistente.
CLEMENTE_DATOS_DIR=
# Degradacion por abuso: rechazos del servidor permitidos por sesion en la
# ventana (segundos) antes de responder sin invocar al modelo.
CLEMENTE_MAX_RECHAZOS=5
CLEMENTE_ABUSO_VENTANA=600

# --- Trello: donde el staff trabaja los tickets (Acuerdo 4 de la asesoria) ----
# Boris [05:59]: "necesitas una herramienta de persistencia, de seguimiento y a
# la vez notificacion". La notificacion al responsable la manda Trello, no
# nosotros: por eso hay que asignarle la tarjeta a alguien del equipo.
#
# Como obtener las credenciales:
#   1. trello.com/power-ups/admin -> crear un Power-Up
#   2. dentro, pestana "API Key" -> Generate a new API Key
#   3. al lado de la key, enlace "Token" -> autorizar
#
# El tablero debe tener estas cuatro listas, con estos nombres exactos:
#   Pendiente | En atencion | Esperando cliente | Resuelto
# y estas etiquetas: espera, servicio, producto, reserva, otro
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_TABLERO=Incidencias Clemente

# Backend de incidencias, en detalle:
#   mcp     -> cliente MCP -> servidor MCP -> API de Trello   (Sesion 16, el default)
#   trello  -> API de Trello directo                          (respaldo, sin protocolo)
#   json    -> archivo local                                  (sin credenciales)
# Con "auto" gana mcp si hay credenciales de Trello.
#
# TRELLO_MCP_URL vacio = servidor MCP en memoria, en el mismo proceso: asi corren
# las pruebas, la evaluacion y el red team, sin depender de levantar nada.
# Para la demostracion, levantar el servidor y apuntar aqui:
#   python -m app.incidencias.mcp_trello --http
TRELLO_MCP_URL=
TRELLO_MCP_PUERTO=8100

# Sesiones del webchat: clave aleatoria larga, privada y estable entre reinicios.
# Vacia = clave efimera del proceso; al reiniciar invalida las cookies anteriores.
CLEMENTE_SECRET_KEY=

TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_WHATSAPP_FROM=
# URL publica exacta registrada en Twilio, sin query string; permite validar
# firmas detras del proxy HTTPS de Azure sin confiar en cabeceras del cliente.
TWILIO_WEBHOOK_URL=
CLEMENTE_DATABASE_URL=
CLEMENTE_CHAT_SESSION_DAYS=7
# Credencial exclusiva del personal para aprobar/rechazar revisiones HITL.
CLEMENTE_HITL_TOKEN=

# Servicio aislado de Guardrails AI. Vacio = solo controles locales y PIIMiddleware.
CLEMENTE_GUARDRAILS_URL=
CLEMENTE_GUARDRAILS_TOKEN=
CLEMENTE_GUARDRAILS_TIMEOUT=3
