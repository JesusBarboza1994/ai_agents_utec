server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Reenvia la API al backend de Clemente. `$proxy_host` como Host y SNI hacen que
    # funcione contra un backend HTTPS detras de otro dominio (Railway, Azure).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_ssl_server_name on;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri /index.html;
    }
}
