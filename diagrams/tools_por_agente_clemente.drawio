        <mxCell id="c11" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;SIN HERRAMIENTAS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Orquestador&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;planificador + cierre&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;decide, no actúa&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;ORQUESTADOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Sin herramientas&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;delega, escala o responde directo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;el escalamiento lo abre el cierre con el mismo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;cliente de incidencias (persona → tipo otro)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="520" height="130" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;AGENTE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Información&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;proxy de consultas&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;solo lectura&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;INFORMACIÓN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;buscar_en_catalogo · consultar_politica&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;get_current_datetime&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;consultar_politica es la fuente única de las políticas:&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;la usan los tres agentes&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="290" width="520" height="140" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;RAG&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Índice del catálogo&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;RAG_BACKEND = azure_search | chroma&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;índice catalogo-clemente&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;AZURE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Azure AI Search&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;vectores + embeddings de Azure OpenAI&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1270" y="300" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;AGENTE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Reservas y Capacidad&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;prepara; nunca ejecuta&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;nunca toca una reserva ajena&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;(acceso por teléfono o código)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="270" height="150" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;RESERVAS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;consultar_disponibilidad&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;crear / modificar / cancelar_reserva (solo preparan)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;buscar_mis_reservas · consultar_reserva_por_codigo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;escalar_a_staff · solicitar_excepcion_grupo (HITL)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;actualizar_datos_cliente · consultar_politica&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;get_current_datetime&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• dia_semana se compara con la fecha en el servidor&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• el horario se valida antes de consultar, preparar o escalar&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• un error del servicio corta el turno: nunca se&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  convierte en 'no hay disponibilidad'&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="520" height="370" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;NUEVO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Horario de atención&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;fecha.HORARIO: una sola tabla&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;para los prompts y la validación&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;lunes cerrado · domingo solo almuerzo&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="900" y="460" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;CÓDIGO DEL SERVIDOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Autorización CONFIRMO&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;SQLite propio · un solo uso · 10 min · 5 intentos&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;revalida el horario del destino al preparar&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="900" y="590" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;CÓDIGO DEL SERVIDOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Servicio de reservas (Miguel)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;CLEMENTE_BACKEND_RESERVAS = postgres | json&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;lock de mesas + índice único por turno&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;+ índice de idempotencia&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="900" y="720" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;NUEVO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;HITL · grupos de más de 8&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;prevalidación sin modelo antes de encolar&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;checkpoint SQLite + cola revisiones_hitl.json&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;en revisión = interrupción real del staff;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;un turno cortado por un error se descarta&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;CANCELAR SOLICITUD · vence a las 24 h&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;pausa huérfana se libera&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="900" y="850" width="320" height="200" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;BASE DE DATOS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;mesas · reservas&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1270" y="720" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;APROBACIÓN HUMANA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Panel del staff&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;página del webchat (chat.html)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;Bearer CLEMENTE_HITL_TOKEN&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;todavía no está en el dashboard&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1270" y="885" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;AGENTE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Incidencias y Experiencia&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;registra; no cierra&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;ni compensa&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="1090" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;INCIDENCIAS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;registrar_incidencia · consultar_incidencia&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;verificar_reserva_del_reclamo · buscar_casos_similares&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;actualizar_datos_cliente · consultar_politica&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;get_current_datetime&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• da el código solo después de registrar&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• con un código existente: informa y se detiene&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="1070" width="520" height="170" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;CÓDIGO DEL SERVIDOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Cliente de incidencias&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;CLEMENTE_BACKEND_INCIDENCIAS =&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;auto | mcp | trello | json&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;(auto: MCP si hay credenciales de Trello)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="900" y="1060" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;RAG&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Casos resueltos (RAG)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;índice incidencias-clemente, k = 2&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;solución + cuándo escalar&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="900" y="1200" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;SISTEMA DEL EQUIPO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Trello&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;Pendiente · En atención ·&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;Esperando cliente · Resuelto&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1270" y="1060" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;AZURE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Azure AI Search + Blob&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;casos .md en stclmt01/incidencias&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1270" y="1200" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;COMPARTIDA · RESERVAS E INCIDENCIAS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;actualizar_datos_cliente&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;nombre, apellido, DNI, teléfono de contacto y&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;mascota · cumpleanos · preferencia_zona&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;nunca tarjeta, clave ni token; nunca la columna phone&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="1290" width="520" height="110" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;BASE DE DATOS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;PostgreSQL · customers&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;ficha del cliente por chat_key&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1270" y="1330" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;DISEÑO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Diseño&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• el orquestador no tiene herramientas: decide&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• información solo lee&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• crear / modificar / cancelar solo preparan;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  la escritura no pasa por el modelo (CONFIRMO)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• incidencias no puede cerrar ni compensar&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• get_current_datetime fecha 'mañana' con el&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  reloj de Lima, no con la memoria del modelo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• PIIMiddleware redacta correo y tarjeta en&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  entradas, salidas y resultados de tools&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1640" y="130" width="420" height="340" as="geometry"/></mxCell>
        <mxCell id="c34" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;FUERA DE ESTA RAMA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Pendiente, de otros responsables&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• pestaña de aprobaciones en el dashboard (Jesús)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• token en GET /api/reservas y /api/chats (Jesús)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• avisar por WhatsApp al resolver (Jesús)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• llevar el horario a validaciones.py (Miguel)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• filtro de nombre ante '?' o '!' (Miguel)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• aprobar no crea la reserva sola (F13)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1640" y="500" width="420" height="270" as="geometry"/></mxCell>
