<mxfile host="Electron">
  <diagram name="Orquestacion de agentes" id="orquestacion_agentes_clemente">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c3" value="Clemente · orquestación acotada de agentes especializados" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell>
        <mxCell id="c4" value="StateGraph propio: planificador → hasta 2 pasos → cierre · cada agente es un ciclo ReAct modelo ⇄ herramientas · el orquestador decide una vez por turno: no es un cuarto agente" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1480" height="34" as="geometry"/></mxCell>
        <mxCell id="c5" value="Nuevo en feat/orquestacion-acotada" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1540" y="14" width="260" height="26" as="geometry"/></mxCell>
        <mxCell id="c6" value="Otros responsables / externo" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1810" y="14" width="250" height="26" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;CANAL&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Webchat / WhatsApp&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;mensaje del cliente&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;un audio llega ya transcrito&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;(ElevenLabs, de Jesús)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;COMUNICACIÓN · JESÚS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;chat_service&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;PII y Guardrails de entrada&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;historial y ficha del cliente&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;en Postgres&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="120" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;COMANDOS EXACTOS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Antes del grafo&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;código, sin modelo:&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• CONFIRMO &amp;lt;código&amp;gt; → el servidor&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  valida el código y escribe&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• CANCELAR SOLICITUD → libera&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  la pausa del staff&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;responde sin entrar al grafo&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="250" y="280" width="240" height="170" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;CICLO REACT DENTRO DE CADA AGENTE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;create_agent (LangChain)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;modelo → herramienta → resultado → modelo, hasta responder&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;tope de 45 pasos por turno (LIMITE_DE_PASOS)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;gpt-5.6-luna con reasoning_effort=none: aquí ReAct es&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;acción y observación, no una cadena de pensamiento larga&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;PIIMiddleware: correo y tarjeta en entrada, salida y tools&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="470" height="200" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;REGLAS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Reglas del plan&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• casi siempre 1 paso; 2 como máximo (lo fuerza el código)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• nunca repite componente; paso y tarea no se separan&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• lo que ya salió mal va antes que lo nuevo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• un pedido de mesa siempre lleva reservas&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• un paso que depende de otro se ofrece, no se ejecuta&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• más de 2 temas: el cierre avisa lo que quedó pendiente&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• si el planificador falla: el componente que venía&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  atendiendo, o información, sin tarea&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="470" height="260" as="geometry"/></mxCell>
        <mxCell id="c12" value="ORQUESTADOR · StateGraph (app/orquestador/grafo.py)" style="rounded=0;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;html=1;fontSize=12;fontStyle=1;fontColor=#36648b;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="1540" height="900" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;PLANIFICA Y DECIDE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Planificador&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;1 llamada con salida estructurada&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;recibe: últimos 6 mensajes, componente&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;que venía atendiendo, tarea ofrecida&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;el turno anterior, calendario de Lima&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;y horario de atención&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;decide: entendimiento · datos resueltos ·&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;restricciones · acción · pasos con tarea&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="550" y="140" width="300" height="240" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;EJECUCIÓN CONTROLADA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Control entre pasos&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;código, sin modelo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;antes del 2.º paso se detiene si hay:&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;revisión del staff pendiente · hilo pausado ·&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;acceso denegado · CONFIRMO pendiente&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;un 2.º paso dependiente queda ofrecido&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="550" y="410" width="300" height="180" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;DELEGACIÓN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Bloque de coordinación&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;tarea + datos resueltos + restricciones&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;+ respuesta del paso anterior&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;viaja como dato junto al mensaje,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;nunca como mensaje de sistema&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="550" y="620" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;AGENTE · PROXY DE CONSULTAS DEL ORQUESTADOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Información&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;solo lectura: buscar_en_catalogo · consultar_politica · get_current_datetime&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;prompt PROMPT_ORQUESTADOR (nombre histórico) en formato ReAct&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="960" y="140" width="540" height="130" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;AGENTE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Reservas y Capacidad&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;consultar_disponibilidad · crear / modificar / cancelar_reserva (preparan)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;buscar_mis_reservas · consultar_reserva_por_codigo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;escalar_a_staff · solicitar_excepcion_grupo (HITL, más de 8)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;actualizar_datos_cliente · consultar_politica · get_current_datetime&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;nuevo: valida el horario de atención en código&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;nuevo: prevalida la solicitud antes de la cola del staff&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="960" y="300" width="540" height="250" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;AGENTE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Incidencias y Experiencia&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;registrar_incidencia · consultar_incidencia · verificar_reserva_del_reclamo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;buscar_casos_similares · actualizar_datos_cliente&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;consultar_politica · get_current_datetime&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;sin herramienta de cierre ni de compensación&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="960" y="580" width="540" height="170" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;DECISIÓN DEL ORQUESTADOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Acción directa, sin agente&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;escalar_humano → el cierre abre el caso (tipo otro)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;responder_directo → saludo, gracias, despedida&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;o algo fuera de alcance, sin ningún pedido&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="960" y="780" width="540" height="150" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;ÚNICA SALIDA DEL GRAFO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Cierre&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;respuesta directa · texto del agente ·&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;síntesis (1 llamada, solo con 2 pasos) ·&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;resumen del servidor si espera CONFIRMO&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;escalamiento: persona → tipo otro, sin hablar de mesa;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;grupo o conflicto → tipo reserva; un caso por hilo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;oferta del paso diferido y aviso de pendientes&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;ruta = quién respondió&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;continuar_con = quién atiende el próximo mensaje&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1550" y="300" width="480" height="300" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;ANTES Y DESPUÉS DEL GRAFO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Pausas de revisión humana&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;solo cuenta como revisión una interrupción real del staff&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;un turno cortado por un error (herramienta que falló)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;se descarta antes del mensaje nuevo: no es una revisión&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;después del grafo: pausa vencida (24 h) o huérfana&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ se libera y se le avisa al cliente&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;revisión válida → cola del staff, con su hora&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1550" y="640" width="480" height="200" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;COMUNICACIÓN · JESÚS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Validación de salida y guardado&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;Guardrails de salida · redacción de PII&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;mensaje guardado en Postgres&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1550" y="1020" width="480" height="100" as="geometry"/></mxCell>
        <mxCell id="c23" value="mensaje" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c24" value="texto validado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c25" value="si no es comando" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c26" value="tarea" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c27" value="tarea" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c28" value="tarea" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell>
