<mxfile host="Electron">
  <diagram name="Plan de resolucion" id="plan_de_resolucion_clemente">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="1260" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c3" value="Clemente · cómo decide el orquestador (plan de resolución)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="34" as="geometry"/></mxCell>
        <mxCell id="c4" value="Una llamada al modelo por turno: primero entiende y marca restricciones, después elige la acción y arma las tareas · el tope de 2 pasos, la unión paso-tarea y el paso diferido los garantiza el código" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1480" height="34" as="geometry"/></mxCell>
        <mxCell id="c5" value="Nuevo en feat/orquestacion-acotada" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1540" y="14" width="260" height="26" as="geometry"/></mxCell>
        <mxCell id="c6" value="Otros responsables / externo" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1810" y="14" width="250" height="26" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;ENTRADA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Último mensaje&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;+ últimos 6 mensajes del hilo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;+ componente que venía atendiendo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;+ calendario de Lima y horario&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;+ tarea ofrecida el turno anterior&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="c8" value="¿Es exactamente&lt;br&gt;CONFIRMO &amp;lt;código&amp;gt;&lt;br&gt;o CANCELAR SOLICITUD?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;RESULTADO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Comando, sin modelo&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;lo resuelve el servidor antes del grafo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;CONFIRMO ejecuta · CANCELAR libera la pausa&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="590" y="140" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;1 · SALIDA ESTRUCTURADA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Entiende y marca&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;entendimiento · datos resueltos&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;dia_cerrado · fuera_de_horario&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;grupo_grande · pide_humano&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;reclamo · condicional&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;fuera_de_alcance&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="285" width="240" height="140" as="geometry"/></mxCell>
        <mxCell id="c11" value="¿Pide una persona&lt;br&gt;y no hay reclamo?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="450" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;RESULTADO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;escalar_humano&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;sin agente: el cierre abre el caso&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;tipo otro, sin hablar de mesa&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="590" y="460" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="c13" value="¿Solo saludo,&lt;br&gt;gracias, despedida&lt;br&gt;o algo ajeno?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="610" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;RESULTADO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;responder_directo&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;una o dos frases con la voz de Clemente&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;saludo + pedido NO entra aquí&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="590" y="620" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="c15" value="¿Acepta la tarea&lt;br&gt;ofrecida el turno&lt;br&gt;anterior?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="770" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;RESULTADO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Un paso con la tarea guardada&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;si el modelo no la copia, el código la repone&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;la oferta vive un solo turno&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="590" y="780" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="c17" value="¿Trae o comenta&lt;br&gt;una imagen?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="930" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;RESULTADO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Según lo que quiere hacer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;algo salió mal → incidencias&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;qué es / el local / ajena → información&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;le gana a la regla de continuidad&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="590" y="940" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="c19" value="¿Completa lo que&lt;br&gt;se venía hablando?&lt;br&gt;(dato, sí/no, código)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="980" y="130" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;RESULTADO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Un paso: el mismo componente&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;cambia solo ante otro alcance claro&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;o ante pide_humano&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1270" y="140" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="c21" value="¿Reclamo y además&lt;br&gt;pide una mesa?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="980" y="290" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;RESULTADO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Dos pasos&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;incidencias → reservas, cada uno con su tarea&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;lo que ya salió mal va primero&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1270" y="300" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="c23" value="¿Una pregunta&lt;br&gt;condiciona la&lt;br&gt;reserva?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="980" y="450" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;RESULTADO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Información + reserva ofrecida&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;depende_del_anterior: la reserva no corre;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;se ofrece y un 'sí' la retoma el próximo turno&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1270" y="460" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="c25" value="¿Pide, cambia,&lt;br&gt;cancela o ve&lt;br&gt;una mesa?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="980" y="610" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;RESULTADO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Reservas, siempre&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;la tarea lleva las restricciones&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;(lunes → ofrecer otro día antes de pedir datos)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1270" y="620" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="c27" value="¿Se queja de algo&lt;br&gt;que ya ocurrió?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="980" y="770" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;RESULTADO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Incidencias&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;también para consultar un caso anterior&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;con su código&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1270" y="780" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="c29" value="¿Cuenta un dato suyo&lt;br&gt;sin preguntar nada?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="980" y="930" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;RESULTADO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Reservas (lo guarda en la ficha)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;si además pregunta una política:&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;información → reservas&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1270" y="940" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;POR DEFECTO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Información&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;ante la duda sin hilo previo:&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;lo más barato de equivocarse&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="980" y="1100" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;FALLBACK&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Si el planificador falla&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;el componente que venía atendiendo,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;o información, siempre sin tarea&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;(error de Azure, filtro de contenido,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;esquema rechazado por el modo estricto)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1270" y="1100" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;DESPUÉS DEL MODELO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Normalización en código&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• paso y tarea se unen antes de limpiar&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• sin repetidos ni desconocidos, tope de 2&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• pasos sin tarea: corren como antes&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• responder_directo sin texto → delegar&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• delegar sin pasos → información&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• más de 2 temas: PENDIENTE en el motivo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  y el cierre lo avisa al cliente&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• campos nuevos opcionales con None:&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  lo exige el modo estricto de Azure&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1660" y="130" width="400" height="270" as="geometry"/></mxCell>
        <mxCell id="c34" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;DISEÑO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Por qué así&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• lo que ya salió mal se atiende antes, sin&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  perder la reserva&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• información es el respaldo: nunca&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  compromete capacidad&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• una condición ('si se puede…') no se&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  puede acreditar en código: se pregunta&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• pedir una persona no pasa por un agente:&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  deja caso y responde más rápido&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• sin juez en vivo por latencia: la calidad&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  se mide con evaluaciones fuera de línea&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1660" y="430" width="400" height="300" as="geometry"/></mxCell>
        <mxCell id="c35" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#36648b&quot;&gt;&lt;b&gt;LÍMITES&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Lo que el modelo NO decide&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• disponibilidad, códigos ni políticas:&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  eso lo traen las herramientas&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• si un día está abierto: lo valida&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;  fecha.HORARIO en la herramienta&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;• ejecutar una reserva: solo CONFIRMO&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1660" y="760" width="400" height="200" as="geometry"/></mxCell>
        <mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>
